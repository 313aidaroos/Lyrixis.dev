# Copy this file to .env.local and fill in real values.
# NEVER commit secrets. `.env.local` and `.env` are gitignored.

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Marketing waitlist (POST /api/waitlist) inserts into enterprise_leads with the service role.
# No extra env vars. Never expose SUPABASE_SERVICE_ROLE_KEY to the browser.

# ---------- Processing ----------
# Lyrics run inside the Vercel function (after()). ffmpeg-static + Whisper. No Redis, no Railway.
# Optional: path to a system ffmpeg; by default the bundled ffmpeg-static binary is used.
FFMPEG_PATH=

# ---------- AI providers (swappable — see Brief section 2) ----------
# TRANSCRIPTION_PROVIDER selects a real adapter. Missing keys fail the job; there is no mock path.
TRANSCRIPTION_PROVIDER=whisper_v3
TRANSCRIPTION_API_KEY=
# Provider is OpenAI (owner decision 2026-10-05). Base defaults to https://api.openai.com/v1 and model to
# whisper-1 (the only OpenAI model that returns word + segment timestamps in verbose_json; gpt-4o-transcribe
# does not, so synced lyrics would break). Any other OpenAI-compatible base also works.
TRANSCRIPTION_API_BASE_URL=
TRANSCRIPTION_MODEL=whisper-1
# Published provider rate used to convert actual billed duration into costCents (USD cents, fractional OK).
# OpenAI Whisper is $0.006/minute = 0.6 cents/minute. Override if you use another vendor.
TRANSCRIPTION_CENTS_PER_MINUTE=0.6

LANGUAGE_PROVIDER=whisper
LANGUAGE_API_KEY=

# Optional. If unset, word timings from transcription are kept and the align step is skipped.
ALIGNMENT_PROVIDER=
ALIGNMENT_API_KEY=

# Deferred product features — interfaces exist, do not wire into the MVP worker.
TRANSLATION_PROVIDER=
TRANSLATION_API_KEY=
AUDIO_ANALYSIS_PROVIDER=
AUDIO_ANALYSIS_API_KEY=

# ---------- Storage ----------
STORAGE_BUCKET=lyrixis-audio-private
MAX_UPLOAD_MB=100
MAX_DURATION_SECONDS=720

# ---------- App ----------
APP_URL=http://localhost:3000
SUPPORT_EMAIL=Lyrixis@Apixis.dev

# ── Added 2026-09-25: keys the code reads that were not listed here ──
# Required
# Cixy's AI (console.anthropic.com → API keys). Server only.
ANTHROPIC_API_KEY=
# Transactional email (resend.com). Needed for support/sign-in emails.
RESEND_API_KEY=
# This site's Apixis Wallet key (apx_live_…). From `npm run family-keys` in ApixisWallet. Server only.
WALLET_API_KEY=
# Optional
# Optional model override. Default is set in code.
AI_MODEL=
# Optional. `anthropic` (default).
AI_PROVIDER=
# Optional model override. Default is set in code.
ANTHROPIC_MODEL=
# Wallet base URL. Default https://apixis-wallet.vercel.app
APIXIS_WALLET_API_URL=
# Sender for support email, e.g. `Lyrixis <lyrixis@apixis.dev>`. Has a default.
EMAIL_FROM=
# Public site URL, e.g. https://<site>.vercel.app
NEXT_PUBLIC_APP_URL=
# Legacy names (leave unset)
# Legacy name for WALLET_API_KEY. Leave unset.
# APIXIS_WALLET_API_KEY=

# ---------- Apixis world (own agent on signup) ----------
# Per-product key for https://www.apixis.dev/api/agent/provision (server-only; unset = feature off).
APIXIS_WORLD_KEY=

# --- Read by the code but missing above (added 2026-10-02) ---
APIXIS_CLIENT_ID=lyrixis
# optional; defaults to <this site>/auth/apixis/callback
APIXIS_REDIRECT_URI=
# optional; defaults to https://apixis.dev
APIXIS_WORLD_API=
# this site's public URL
NEXT_PUBLIC_SITE_URL=
# optional; new-style key instead of the anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# optional; new-style key instead of the service role key
SUPABASE_SECRET_KEY=

# Lyrics processing runs in the Vercel function. Audio is sent to OpenAI as 16 kHz mono MP3 64k.
# Leave the base URL empty, TRANSCRIPTION_MODEL=whisper-1, TRANSCRIPTION_CENTS_PER_MINUTE=0.6.

# ---------- Lyrixis Voices (docs/voices/SETUP_AND_DEPLOY.md) ----------
# demo (default off-production) | live. Production is always live.
VOICES_DATA_MODE=
# true opens /voices in production (leave unset until launch checklist is done)
VOICES_LIVE=
# default on; "false" opens Voices to every signed-in user
VOICES_INVITE_ONLY=true
# 32+ chars, required in production (signed file links)
VOICES_SIGNING_SECRET=
# ElevenLabs adapter (unset = live voices cannot generate; no fallback)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_USD_PER_1K_CHARS=0.10
ELEVENLABS_API_BASE=
# Bearer for /api/voices/jobs/run (Vercel Cron)
CRON_SECRET=
# Bearer for /api/v1/voices/metrics (aggregate only)
AWAD_COMMAND_METRICS_KEY=
# true shows the Voices link in the site nav in production (previews show it automatically)
NEXT_PUBLIC_VOICES_NAV=

# ---------- Voice Songs (Sing it yourself, approved 2026-10-12) ----------
# Names only. Leave every value empty. Do not commit secrets.
# Desk demo (/voice-songs/desk): stand-in audio and demo Ixis. No vendor is called.
# Unset: on outside production, off in production. "false" disables it everywhere.
VOICE_SONGS_DEMO=
# memory (default when Supabase is unset) or supabase. Desk store only.
VOICE_SONGS_STORE=
# Shared with Voices above. Missing key => the live studio says not configured.
ELEVENLABS_API_KEY=
# Optional override. Default https://api.elevenlabs.io
ELEVENLABS_API_BASE=
# Optional. Studio default is music_v2. music_v1 and music_v2_5 also work.
ELEVENLABS_MUSIC_MODEL=
# Required for RVC training + re-sing. Missing key => not configured.
REPLICATE_API_TOKEN=
# Optional fallback when REPLICATE_API_TOKEN is unset. KITS_MODEL_ID must be a model of the user's own voice.
KITS_API_KEY=
KITS_API_BASE=
KITS_MODEL_ID=
# Read-aloud check uses TRANSCRIPTION_API_KEY above.
# Set to 1 to render a placeholder tone so the studio can be screenshotted without provider keys.
# Leave unset in production. Mock audio is not a cloned voice.
VOICE_SONGS_MOCK=
# Card checkout. Leave STRIPE_SECRET_KEY unset to show "Card coming soon".
# Voice-song Ixis stays closed until VOICE_SONGS_PAYMENTS=live and the Wallet SKUs are registered.
VOICE_SONGS_PAYMENTS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Distributor adapter. toolost, too_lost, or revelator. Leave unset until a quote is signed.
VOICE_SONGS_DISTRIBUTOR=
TOO_LOST_API_KEY=
TOO_LOST_API_BASE=
REVELATOR_API_KEY=
REVELATOR_API_BASE=
